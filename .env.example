# Fiskr Environment Variables & Secrets Configuration

# Database Connection Settings
# Option A: Full Database Connection URL
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5438/fiskr

# Option B: Individual Database Parameters
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5438
DB_NAME=fiskr

# Authentication & JWT Security Settings
SECRET_KEY=fiskr_super_secret_jwt_key_change_in_production_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Envoi des emails (rapports de synchronisation ET notifications d'etape).
# Laissez vide pour un suivi uniquement dans l'application.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=fiskr@example.com
# SMTP_PASSWORD=motdepasse_smtp
# SMTP_FROM=fiskr@example.com
# SYNC_EMAIL_TO=conformite@example.com,responsable-lcb@example.com

# Notifications d'etape (production des listes, criblage, filtrage).
# Les destinataires sont d'abord deduits des ROLES (adresse email de chaque
# compte) ; NOTIFY_EMAIL_TO n'est utilise qu'en repli, quand aucun compte de
# l'audience n'a d'adresse renseignee.
# NOTIFY_EMAIL_TO=conformite@example.com
# URL publique de l'application : active le bouton « Ouvrir dans Fiskr » des
# mails (lien direct vers l'ecran concerne). Vide = mails sans bouton.
# FISKR_PUBLIC_URL=https://fiskr.example.com

# Fonctions IA optionnelles (API Claude), reglables a chaud dans l'ecran
# Reglages : reformulation en prose des narratifs d'alerte, et generation de
# regles anti-faux-positifs a partir d'une description en langage naturel.
# Sans cette cle, les deux fonctions refusent proprement — le reste de Fiskr
# est inchange, aucun appel externe n'a lieu.
# ANTHROPIC_API_KEY=sk-ant-...

# Mode d'execution de la file de travaux. PRIME sur `jobs.mode` de config.yaml.
# A ne definir que pour forcer un mode : le demon se marque lui-meme `worker`
# et la suite de tests bascule en `eager`.
#   worker : demon dedie (production)  ·  thread : threads du processus API
#   eager  : execution inline synchrone (tests)
# FISKR_JOBS_MODE=worker

# Prechauffage du cache de criblage au demarrage du processus web.
# A LAISSER VIDE sur un hebergement mutualise : Passenger recycle ses processus,
# chacun paierait le chargement, et il tue un processus qui n'a pas fini de
# demarrer. Reservez-le a un hebergement dedie (cf. fiskr/wsgi.py).
# FISKR_PRELOAD_CACHE=1
